rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ استبدل ADMIN_UID بمعرّف حساب الأدمن (Firebase Console → Authentication → Users → User UID)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'A2Qj42zR5YeD1s6ASH247KeDRh52';
    }

    // المنتجات والإعدادات: قراءة للجميع، كتابة للأدمن فقط
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shop/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // الطلبات: الزبون ينشئ فقط (بشروط صارمة)، والأدمن وحده يقرأ/يعدّل/يحذف
    match /orders/{id} {
      allow read, update, delete: if isAdmin();

      allow create: if id.matches('^ZN[A-Z0-9]{1,6}$')
        && request.resource.data.keys().hasOnly([
            'productId','productName','unitPrice','qty','color','size','customer','phone','phone2',
            'wilayaCode','wilaya','wilayaAr','commune','address','notes','deliveryType','carrier',
            'shipping','subtotal','total','discountPct','discountAmt','lang','createdAt','status','ref','sheetSynced'])
        && request.resource.data.status == 'pending'
        && request.resource.data.customer is string && request.resource.data.customer.size() > 0 && request.resource.data.customer.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^0?[5-7][0-9]{8}$')
        && request.resource.data.commune is string && request.resource.data.commune.size() <= 120
        && request.resource.data.address is string && request.resource.data.address.size() <= 250
        && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 50
        && request.resource.data.deliveryType in ['home','desk']
        && request.resource.data.shipping is number && request.resource.data.shipping >= 0 && request.resource.data.shipping <= 5000
        && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.shipping
        // السعر يجب أن يطابق سعر المنتج الحقيقي في قاعدة البيانات
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price == request.resource.data.unitPrice;
    }

    // الطلبات غير المكتملة: الزبون يكتب مستنداً واحداً لكل رقم هاتف (بشروط صارمة)، والأدمن وحده يقرأ/يعدّل/يحذف
    function validLead(id, d) {
      return id.matches('^[5-7][0-9]{8}$')
        && d.keys().hasOnly(['phone','customer','productId','productName','wilayaCode','wilaya','commune','err','done','startedAt','updatedAt'])
        && d.keys().hasAll(['phone','customer','productId','productName','wilayaCode','wilaya','commune','err','done','startedAt','updatedAt'])
        && d.phone == id
        && d.customer is string && d.customer.size() <= 80
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 80
        && d.productName is string && d.productName.size() <= 120
        && d.wilayaCode is int && d.wilayaCode >= 0 && d.wilayaCode <= 99
        && d.wilaya is string && d.wilaya.size() <= 60
        && d.commune is string && d.commune.size() <= 120
        && d.err is string && d.err.size() <= 40
        && d.done is bool
        && d.startedAt is string && d.startedAt.size() <= 40
        && d.updatedAt is string && d.updatedAt.size() <= 40;
    }
    match /leads/{id} {
      allow read, update, delete: if isAdmin();
      allow create, update: if validLead(id, request.resource.data);
    }

    // بيانات حساسة (توكنات شركات التوصيل…): الأدمن فقط
    match /private/{document=**} {
      allow read, write: if isAdmin();
    }

    // كل شيء آخر مرفوض
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
